{"surah":101,"ayahs":[{"i":6158,"n":1,"ar":"اَلْقَارِعَةُۙ","tr":"Al-qāri‘ah(tu).","tid":"Al-Qāri‘ah (hari Kiamat yang menggetarkan).","ten":"The Striking Calamity -","juz":30,"page":600,"ruku":543,"manzil":7,"hizb":240,"sajda":false},{"i":6159,"n":2,"ar":"مَا الْقَارِعَةُ ۚ","tr":"Mal-qāri‘ah(tu).","tid":"Apakah al-Qāri‘ah itu?","ten":"What is the Striking Calamity?","juz":30,"page":600,"ruku":543,"manzil":7,"hizb":240,"sajda":false},{"i":6160,"n":3,"ar":"وَمَآ اَدْرٰىكَ مَا الْقَارِعَةُ ۗ","tr":"Wa mā adrāka mal-qāri‘ah(tu).","tid":"Tahukah kamu apakah al-Qāri‘ah itu?","ten":"And what can make you know what is the Striking Calamity?","juz":30,"page":600,"ruku":543,"manzil":7,"hizb":240,"sajda":false},{"i":6161,"n":4,"ar":"يَوْمَ يَكُوْنُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوْثِۙ","tr":"Yauma yakūnun-nāsu kal-farāsyil-mabṡūṡ(i).","tid":"Pada hari itu manusia seperti laron yang beterbangan","ten":"It is the Day when people will be like moths, dispersed,","juz":30,"page":600,"ruku":543,"manzil":7,"hizb":240,"sajda":false},{"i":6162,"n":5,"ar":"وَتَكُوْنُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوْشِۗ","tr":"Wa takūnul-jibālu kal-‘ihnil-manfūsy(i).","tid":"dan gunung-gunung seperti bulu yang berhamburan.","ten":"And the mountains will be like wool, fluffed up.","juz":30,"page":600,"ruku":543,"manzil":7,"hizb":240,"sajda":false},{"i":6163,"n":6,"ar":"فَاَمَّا مَنْ ثَقُلَتْ مَوَازِيْنُهٗۙ","tr":"Fa ammā man ṡaqulat mawāzīnuh(ū).","tid":"Siapa yang berat timbangan (kebaikan)-nya,","ten":"Then as for one whose scales are heavy [with good deeds],","juz":30,"page":600,"ruku":543,"manzil":7,"hizb":240,"sajda":false},{"i":6164,"n":7,"ar":"فَهُوَ فِيْ عِيْشَةٍ رَّاضِيَةٍۗ","tr":"Fa huwa fī ‘īsyatir rāḍiyah(tin).","tid":"dia berada dalam kehidupan yang menyenangkan.","ten":"He will be in a pleasant life.","juz":30,"page":600,"ruku":543,"manzil":7,"hizb":240,"sajda":false},{"i":6165,"n":8,"ar":"وَاَمَّا مَنْ خَفَّتْ مَوَازِيْنُهٗۙ","tr":"Wa ammā man khaffat mawāzīnuh(ū).","tid":"Adapun orang yang ringan timbangan (kebaikan)-nya,","ten":"But as for one whose scales are light,","juz":30,"page":600,"ruku":543,"manzil":7,"hizb":240,"sajda":false},{"i":6166,"n":9,"ar":"فَاُمُّهٗ هَاوِيَةٌ  ۗ","tr":"Fa ummuhū hāwiyah(tun).","tid":"tempat kembalinya adalah (neraka) Hawiyah.","ten":"His refuge will be an abyss.","juz":30,"page":600,"ruku":543,"manzil":7,"hizb":240,"sajda":false},{"i":6167,"n":10,"ar":"وَمَآ اَدْرٰىكَ مَا هِيَهْۗ","tr":"Wa mā adrāka mā hiyah.","tid":"Tahukah kamu apakah (neraka Hawiyah) itu?","ten":"And what can make you know what that is?","juz":30,"page":600,"ruku":543,"manzil":7,"hizb":240,"sajda":false},{"i":6168,"n":11,"ar":"نَارٌ حَامِيَةٌ ࣖ","tr":"Nārun ḥāmiyah(tun).","tid":"(Ia adalah) api yang sangat panas.","ten":"It is a Fire, intensely hot.","juz":30,"page":600,"ruku":543,"manzil":7,"hizb":240,"sajda":false}]}