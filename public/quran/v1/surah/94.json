{"surah":94,"ayahs":[{"i":6091,"n":1,"ar":"اَلَمْ نَشْرَحْ لَكَ صَدْرَكَۙ","tr":"Alam nasyraḥ laka ṣadrak(a).","tid":"Bukankah Kami telah melapangkan dadamu (Nabi Muhammad),","ten":"Did We not expand for you, [O Muhammad], your breast?","juz":30,"page":596,"ruku":536,"manzil":7,"hizb":239,"sajda":false},{"i":6092,"n":2,"ar":"وَوَضَعْنَا عَنْكَ وِزْرَكَۙ","tr":"Wa waḍa‘nā ‘anka wizrak(a).","tid":"meringankan beban (tugas-tugas kenabian) darimu","ten":"And We removed from you your burden","juz":30,"page":596,"ruku":536,"manzil":7,"hizb":239,"sajda":false},{"i":6093,"n":3,"ar":"الَّذِيْٓ اَنْقَضَ ظَهْرَكَۙ","tr":"Allażī anqaḍa ẓahrak(a).","tid":"yang memberatkan punggungmu,","ten":"Which had weighed upon your back","juz":30,"page":596,"ruku":536,"manzil":7,"hizb":239,"sajda":false},{"i":6094,"n":4,"ar":"وَرَفَعْنَا لَكَ ذِكْرَكَۗ","tr":"Wa rafa‘nā laka żikrak(a).","tid":"dan meninggikan (derajat)-mu (dengan selalu) menyebut-nyebut (nama)-mu?","ten":"And raised high for you your repute.","juz":30,"page":596,"ruku":536,"manzil":7,"hizb":239,"sajda":false},{"i":6095,"n":5,"ar":"فَاِنَّ مَعَ الْعُسْرِ يُسْرًاۙ","tr":"Fa'inna ma‘al-‘usri yusrā(n).","tid":"Maka, sesungguhnya beserta kesulitan ada kemudahan.","ten":"For indeed, with hardship [will be] ease.","juz":30,"page":596,"ruku":536,"manzil":7,"hizb":239,"sajda":false},{"i":6096,"n":6,"ar":"اِنَّ مَعَ الْعُسْرِ يُسْرًاۗ","tr":"Inna ma‘al-‘usri yusrā(n).","tid":"Sesungguhnya beserta kesulitan ada kemudahan.","ten":"Indeed, with hardship [will be] ease.","juz":30,"page":596,"ruku":536,"manzil":7,"hizb":239,"sajda":false},{"i":6097,"n":7,"ar":"فَاِذَا فَرَغْتَ فَانْصَبْۙ","tr":"Fa iżā faragta fanṣab.","tid":"Apabila engkau telah selesai (dengan suatu kebajikan), teruslah bekerja keras (untuk kebajikan yang lain)","ten":"So when you have finished [your duties], then stand up [for worship].","juz":30,"page":596,"ruku":536,"manzil":7,"hizb":239,"sajda":false},{"i":6098,"n":8,"ar":"وَاِلٰى رَبِّكَ فَارْغَبْ ࣖ","tr":"Wa ilā rabbika fargab.","tid":"dan hanya kepada Tuhanmu berharaplah!","ten":"And to your Lord direct [your] longing.","juz":30,"page":596,"ruku":536,"manzil":7,"hizb":239,"sajda":false}]}