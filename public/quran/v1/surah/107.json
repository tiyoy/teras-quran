{"surah":107,"ayahs":[{"i":6198,"n":1,"ar":"اَرَءَيْتَ الَّذِيْ يُكَذِّبُ بِالدِّيْنِۗ","tr":"Ara'aital-lażī yukażżibu bid-dīn(i).","tid":"Tahukah kamu (orang) yang mendustakan agama?","ten":"Have you seen the one who denies the Recompense?","juz":30,"page":602,"ruku":549,"manzil":7,"hizb":240,"sajda":false},{"i":6199,"n":2,"ar":"فَذٰلِكَ الَّذِيْ يَدُعُّ الْيَتِيْمَۙ","tr":"Fa żālikal-lażī yadu‘‘ul-yatīm(a).","tid":"Itulah orang yang menghardik anak yatim","ten":"For that is the one who drives away the orphan","juz":30,"page":602,"ruku":549,"manzil":7,"hizb":240,"sajda":false},{"i":6200,"n":3,"ar":"وَلَا يَحُضُّ عَلٰى طَعَامِ الْمِسْكِيْنِۗ","tr":"Wa lā yaḥuḍḍu ‘alā ṭa‘āmil-miskīn(i).","tid":"dan tidak menganjurkan untuk memberi makan orang miskin.","ten":"And does not encourage the feeding of the poor.","juz":30,"page":602,"ruku":549,"manzil":7,"hizb":240,"sajda":false},{"i":6201,"n":4,"ar":"فَوَيْلٌ لِّلْمُصَلِّيْنَۙ","tr":"Fawailul lil-muṣallīn(a).","tid":"Celakalah orang-orang yang melaksanakan salat,","ten":"So woe to those who pray","juz":30,"page":602,"ruku":549,"manzil":7,"hizb":240,"sajda":false},{"i":6202,"n":5,"ar":"الَّذِيْنَ هُمْ عَنْ صَلَاتِهِمْ سَاهُوْنَۙ","tr":"Allażīna hum ‘an ṣalātihim sāhūn(a).","tid":"(yaitu) yang lalai terhadap salatnya,","ten":"[But] who are heedless of their prayer -","juz":30,"page":602,"ruku":549,"manzil":7,"hizb":240,"sajda":false},{"i":6203,"n":6,"ar":"الَّذِيْنَ هُمْ يُرَاۤءُوْنَۙ","tr":"Allażīna hum yurā'ūn(a).","tid":"yang berbuat riya,","ten":"Those who make show [of their deeds]","juz":30,"page":602,"ruku":549,"manzil":7,"hizb":240,"sajda":false},{"i":6204,"n":7,"ar":"وَيَمْنَعُوْنَ الْمَاعُوْنَ ࣖ","tr":"Wa yamna‘ūnal-mā‘ūn(a).","tid":"dan enggan (memberi) bantuan.","ten":"And withhold [simple] assistance.","juz":30,"page":602,"ruku":549,"manzil":7,"hizb":240,"sajda":false}]}