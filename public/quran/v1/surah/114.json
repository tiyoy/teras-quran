{"surah":114,"ayahs":[{"i":6231,"n":1,"ar":"قُلْ اَعُوْذُ بِرَبِّ النَّاسِۙ","tr":"Qul a‘ūżu birabbin-nās(i).","tid":"Katakanlah (Nabi Muhammad), “Aku berlindung kepada Tuhan manusia,","ten":"Say, \"I seek refuge in the Lord of mankind,","juz":30,"page":604,"ruku":556,"manzil":7,"hizb":240,"sajda":false},{"i":6232,"n":2,"ar":"مَلِكِ النَّاسِۙ","tr":"Malikin-nās(i).","tid":"raja manusia,","ten":"The Sovereign of mankind.","juz":30,"page":604,"ruku":556,"manzil":7,"hizb":240,"sajda":false},{"i":6233,"n":3,"ar":"اِلٰهِ النَّاسِۙ","tr":"Ilāhin-nās(i).","tid":"sembahan manusia","ten":"The God of mankind,","juz":30,"page":604,"ruku":556,"manzil":7,"hizb":240,"sajda":false},{"i":6234,"n":4,"ar":"مِنْ شَرِّ الْوَسْوَاسِ ەۙ الْخَنَّاسِۖ","tr":"Min syarril-waswāsil-khannās(i).","tid":"dari kejahatan (setan) pembisik yang bersembunyi","ten":"From the evil of the retreating whisperer -","juz":30,"page":604,"ruku":556,"manzil":7,"hizb":240,"sajda":false},{"i":6235,"n":5,"ar":"الَّذِيْ يُوَسْوِسُ فِيْ صُدُوْرِ النَّاسِۙ","tr":"Allażī yuwaswisu fī ṣudūrin-nās(i).","tid":"yang membisikkan (kejahatan) ke dalam dada manusia,","ten":"Who whispers [evil] into the breasts of mankind -","juz":30,"page":604,"ruku":556,"manzil":7,"hizb":240,"sajda":false},{"i":6236,"n":6,"ar":"مِنَ الْجِنَّةِ وَالنَّاسِ ࣖ","tr":"Minal jinnati wan-nās(i).","tid":"dari (golongan) jin dan manusia.”","ten":"From among the jinn and mankind.\"","juz":30,"page":604,"ruku":556,"manzil":7,"hizb":240,"sajda":false}]}