{"surah":104,"ayahs":[{"i":6180,"n":1,"ar":"وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍۙ","tr":"Wailul likulli humazatil-lumazah(tin).","tid":"Celakalah setiap pengumpat lagi pencela","ten":"Woe to every scorner and mocker","juz":30,"page":601,"ruku":546,"manzil":7,"hizb":240,"sajda":false},{"i":6181,"n":2,"ar":"ۨالَّذِيْ جَمَعَ مَالًا وَّعَدَّدَهٗۙ","tr":"Allażī jama‘a mālaw wa ‘addadah(ū).","tid":"yang mengumpulkan harta dan menghitung-hitungnya.","ten":"Who collects wealth and [continuously] counts it.","juz":30,"page":601,"ruku":546,"manzil":7,"hizb":240,"sajda":false},{"i":6182,"n":3,"ar":"يَحْسَبُ اَنَّ مَالَهٗٓ اَخْلَدَهٗۚ","tr":"Yaḥsabu anna mālahū akhladah(ū).","tid":"Dia (manusia) mengira bahwa hartanya dapat mengekalkannya.","ten":"He thinks that his wealth will make him immortal.","juz":30,"page":601,"ruku":546,"manzil":7,"hizb":240,"sajda":false},{"i":6183,"n":4,"ar":"كَلَّا لَيُنْۢبَذَنَّ فِى الْحُطَمَةِۖ","tr":"Kallā layumbażanna fil-ḥuṭamah(ti).","tid":"Sekali-kali tidak! Pasti dia akan dilemparkan ke dalam (neraka) Hutamah.","ten":"No! He will surely be thrown into the Crusher.","juz":30,"page":601,"ruku":546,"manzil":7,"hizb":240,"sajda":false},{"i":6184,"n":5,"ar":"وَمَآ اَدْرٰىكَ مَا الْحُطَمَةُ ۗ","tr":"Wa mā adrāka mal-ḥuṭamah(tu).","tid":"Tahukah kamu apakah (neraka) Hutamah?","ten":"And what can make you know what is the Crusher?","juz":30,"page":601,"ruku":546,"manzil":7,"hizb":240,"sajda":false},{"i":6185,"n":6,"ar":"نَارُ اللّٰهِ الْمُوْقَدَةُۙ","tr":"Nārullāhil-mūqadah(tu).","tid":"(Ia adalah) api (azab) Allah yang dinyalakan","ten":"It is the fire of Allah, [eternally] fueled,","juz":30,"page":601,"ruku":546,"manzil":7,"hizb":240,"sajda":false},{"i":6186,"n":7,"ar":"الَّتِيْ تَطَّلِعُ عَلَى الْاَفْـِٕدَةِۗ","tr":"Allatī taṭṭali‘u ‘alal-af'idah(ti).","tid":"yang (membakar) naik sampai ke hati.","ten":"Which mounts directed at the hearts.","juz":30,"page":601,"ruku":546,"manzil":7,"hizb":240,"sajda":false},{"i":6187,"n":8,"ar":"اِنَّهَا عَلَيْهِمْ مُّؤْصَدَةٌۙ","tr":"Innahā ‘alaihim mu'ṣadah(tun).","tid":"Sesungguhnya dia (api itu) tertutup rapat (sebagai hukuman) atas mereka,","ten":"Indeed, Hellfire will be closed down upon them","juz":30,"page":601,"ruku":546,"manzil":7,"hizb":240,"sajda":false},{"i":6188,"n":9,"ar":"فِيْ عَمَدٍ مُّمَدَّدَةٍ ࣖ","tr":"Fī ‘amadim mumaddadah(tin).","tid":"(sedangkan mereka) diikat pada tiang-tiang yang panjang.","ten":"In extended columns.","juz":30,"page":601,"ruku":546,"manzil":7,"hizb":240,"sajda":false}]}