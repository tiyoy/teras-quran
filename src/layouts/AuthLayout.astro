---
import BaseHead from './BaseHead.astro';
import { BrandLogo } from '@/components/ui/BrandLogo';
import { ThemeToggle } from '@/components/shell/ThemeToggle';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead title={`${title} · Teras Qur'an`} />
  </head>
  <body class="flex min-h-dvh flex-col bg-[var(--background)] text-[var(--foreground)]">
    <header class="border-b border-[var(--border)] bg-[var(--background)]">
      <div class="mx-auto flex h-14 w-full max-w-md items-center justify-between px-4">
        <BrandLogo href="/" />
        <ThemeToggle client:load />
      </div>
    </header>
    <main class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center px-4 py-10">
      <slot />
    </main>
  </body>
</html>
