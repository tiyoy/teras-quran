---
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Baca Al-Qur'an 30 juz dengan teks Arab, latin, terjemahan, tafsir Kemenag RI, audio murottal per ayat, jadwal murajaah hafalan, jadwal sholat, kiblat, dan tasbih digital. Gratis, tanpa akun.",
} = Astro.props;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content="#0F52BA" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0B111E" media="(prefers-color-scheme: dark)" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="Teras Qur'an" />
<meta name="application-name" content="Teras Qur'an" />
<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Al-Qur'an Digital — Teras Qur'an" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<script is:inline>
  (function () {
    function applySavedTheme(root) {
      try {
        var el = root || document.documentElement;
        var raw = localStorage.getItem('tq:theme');
        var mode = raw ? JSON.parse(raw) : 'system';
        var dark =
          mode === 'dark' ||
          (mode !== 'light' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        el.classList.toggle('dark', dark);
        el.style.colorScheme = dark ? 'dark' : 'light';
      } catch (e) {}
    }

    function applySplashSkip(root) {
      try {
        if (sessionStorage.getItem('tq:splash-seen') === '1') {
          (root || document.documentElement).classList.add('tq-splash-skip');
        }
      } catch (e) {}
    }

    applySavedTheme();
    applySplashSkip();

    document.addEventListener('astro:before-swap', function (ev) {
      if (ev && ev.newDocument && ev.newDocument.documentElement) {
        applySavedTheme(ev.newDocument.documentElement);
        ev.newDocument.documentElement.classList.add('tq-splash-skip');
      }
    });

    document.addEventListener('astro:after-swap', function () {
      applySavedTheme();
      applySplashSkip();
    });

    // Capture PWA install prompt early before Preact islands hydrate
    if (!window.__tqPwaBound) {
      window.__tqPwaBound = true;
      window.addEventListener('beforeinstallprompt', function (e) {
        e.preventDefault();
        window.__tqInstallPrompt = e;
      });
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker
            .register('/sw.js')
            .then(function () {
              return navigator.serviceWorker.ready;
            })
            .then(function (reg) {
              if (navigator.onLine && reg && reg.active) {
                reg.active.postMessage({ type: 'TQ_WARM_OFFLINE' });
              }
            })
            .catch(function () {});
        });
      }
    }
  })();
</script>
