# Konfigurasi Firebase untuk Teras Qur'an
# Salin file ini menjadi .env dan isi nilai dari Firebase Console (Project Settings -> Your apps -> Web)
# Jika dibiarkan kosong, aplikasi tetap berjalan penuh dalam mode lokal (localStorage).

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
